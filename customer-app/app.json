{
  "expo": {
    "name": "JothidaConnect",
    "slug": "astroconnect",
    "version": "1.0.7",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#4C1D95"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.astroconnect.customer",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "JothidaConnect uses the microphone for voice consultations with astrologers."
      }
    },
    "android": {
      "package": "com.astroconnect.customer",
      "adaptiveIcon": {
        "backgroundColor": "#4C1D95"
      },
      "versionCode": 8,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "6449fbd3-f09c-4c26-8d70-0841c5a5a73c"
      }
    },
    "owner": "azhagapan",
    "plugins": [
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "JothidaConnect uses the microphone for voice consultations with astrologers."
        }
      ]
    ]
  }
}
