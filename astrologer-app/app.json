{
  "expo": {
    "name": "JothidaConnect Partner",
    "slug": "astroconnect-partner",
    "version": "1.0.8",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#7C2D12"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.astroconnect.partner",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "JothidaConnect Partner uses the microphone for voice consultations with clients."
      }
    },
    "android": {
      "package": "com.astroconnect.partner",
      "adaptiveIcon": {
        "backgroundColor": "#7C2D12"
      },
      "versionCode": 9,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "extra": {
      "eas": {
        "projectId": "b9c44714-1f7c-4e6b-9a58-10a1e4de5a23"
      }
    },
    "owner": "azhagapan",
    "plugins": [
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "JothidaConnect Partner uses the microphone for voice consultations with clients."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/ring.wav"
          ]
        }
      ]
    ]
  }
}
